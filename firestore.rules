rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny everything unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && isVerified();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'activeMapId', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('activeMapId' in data) || isValidId(data.activeMapId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMindMap(data, userId, mapId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'intention', 'encouragementTitle', 'encouragementNote', 'encouragementStep', 'breathCount', 'waterDrops', 'nourishmentOffset', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == mapId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && (!('intention' in data) || (data.intention is string && data.intention.size() <= 400))
        && (!('encouragementTitle' in data) || (data.encouragementTitle is string && data.encouragementTitle.size() <= 160))
        && (!('encouragementNote' in data) || (data.encouragementNote is string && data.encouragementNote.size() <= 2000))
        && (!('encouragementStep' in data) || (data.encouragementStep is string && data.encouragementStep.size() <= 400))
        && (!('breathCount' in data) || (data.breathCount is number && data.breathCount >= 0 && data.breathCount <= 1000000))
        && (!('waterDrops' in data) || (data.waterDrops is number && data.waterDrops >= 0 && data.waterDrops <= 1000000))
        && (!('nourishmentOffset' in data) || (data.nourishmentOffset is number && data.nourishmentOffset >= 0 && data.nourishmentOffset <= 1000000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMapNode(data, userId, mapId, nodeId) {
      return data.keys().hasAll(['id', 'ownerId', 'mapId', 'text', 'kind', 'priorityTier', 'priorityOrder', 'completed', 'x', 'y', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'mapId', 'text', 'note', 'kind', 'priorityTier', 'priorityOrder', 'completed', 'theme', 'x', 'y', 'sourceDumpId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == nodeId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.mapId is string && data.mapId == mapId && isValidId(data.mapId)
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 600
        && (!('note' in data) || (data.note is string && data.note.size() <= 1200))
        && data.kind in ['thought', 'anchor', 'feeling', 'question']
        && data.priorityTier in ['now', 'next', 'later', 'none']
        && data.priorityOrder is number && data.priorityOrder >= 0 && data.priorityOrder <= 1000
        && data.completed is bool
        && (!('theme' in data) || (data.theme is string && data.theme.size() <= 80))
        && data.x is number && data.x >= -10000 && data.x <= 10000
        && data.y is number && data.y >= -10000 && data.y <= 10000
        && (!('sourceDumpId' in data) || isValidId(data.sourceDumpId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMapEdge(data, userId, mapId, edgeId) {
      return data.keys().hasAll(['id', 'ownerId', 'mapId', 'fromId', 'toId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'mapId', 'fromId', 'toId', 'label', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == edgeId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.mapId is string && data.mapId == mapId && isValidId(data.mapId)
        && isValidId(data.fromId)
        && isValidId(data.toId)
        && (!('label' in data) || (data.label is string && data.label.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBrainDump(data, userId, mapId, dumpId) {
      return data.keys().hasAll(['id', 'ownerId', 'mapId', 'rawText', 'mapped', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'mapId', 'rawText', 'mapped', 'moodWord', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == dumpId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.mapId is string && data.mapId == mapId && isValidId(data.mapId)
        && data.rawText is string && data.rawText.size() >= 1 && data.rawText.size() <= 4000
        && data.mapped is bool
        && (!('moodWord' in data) || (data.moodWord is string && data.moodWord.size() <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPatternInsight(data, userId, mapId, patternId) {
      return data.keys().hasAll(['id', 'ownerId', 'mapId', 'title', 'insight', 'tone', 'relatedNodeIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'mapId', 'title', 'insight', 'tone', 'relatedNodeIds', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == patternId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.mapId is string && data.mapId == mapId && isValidId(data.mapId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.insight is string && data.insight.size() >= 1 && data.insight.size() <= 800
        && data.tone in ['anchor', 'tension', 'momentum', 'rest']
        && data.relatedNodeIds is list
        && data.relatedNodeIds.size() <= 20
        && (data.relatedNodeIds.size() == 0 || (data.relatedNodeIds[0] is string && data.relatedNodeIds[0].size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function ownsParentMap(userId, mapId) {
      return exists(/databases/$(database)/documents/users/$(userId)/maps/$(mapId))
        && get(/databases/$(database)/documents/users/$(userId)/maps/$(mapId)).data.ownerId == request.auth.uid;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'activeMapId', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['activeMapId', 'updatedAt'])
        );
      allow delete: if false;

      match /maps/{mapId} {
        allow get: if isValidId(userId) && isValidId(mapId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(mapId)
          && isVerifiedOwner(userId)
          && isValidMindMap(incoming(), userId, mapId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(mapId)
          && isVerifiedOwner(userId)
          && isValidMindMap(incoming(), userId, mapId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'intention', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['encouragementTitle', 'encouragementNote', 'encouragementStep', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'intention', 'encouragementTitle', 'encouragementNote', 'encouragementStep', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['breathCount', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['waterDrops', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['breathCount', 'waterDrops', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['breathCount', 'waterDrops', 'nourishmentOffset', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(mapId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;

        match /nodes/{nodeId} {
          allow get: if isValidId(userId) && isValidId(mapId) && isValidId(nodeId)
            && isOwner(userId) && existing().ownerId == request.auth.uid;
          allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(mapId) && isValidId(nodeId)
            && isVerifiedOwner(userId)
            && isValidMapNode(incoming(), userId, mapId, nodeId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && ownsParentMap(userId, mapId);
          allow update: if isValidId(userId) && isValidId(mapId) && isValidId(nodeId)
            && isVerifiedOwner(userId)
            && isValidMapNode(incoming(), userId, mapId, nodeId)
            && incoming().id == existing().id
            && incoming().ownerId == existing().ownerId
            && incoming().mapId == existing().mapId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['x', 'y', 'updatedAt'])
              || incoming().diff(existing()).affectedKeys().hasOnly(['priorityTier', 'priorityOrder', 'x', 'y', 'updatedAt'])
              || incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt'])
              || incoming().diff(existing()).affectedKeys().hasOnly(['text', 'note', 'kind', 'theme', 'priorityTier', 'priorityOrder', 'completed', 'x', 'y', 'updatedAt'])
            );
          allow delete: if isValidId(userId) && isValidId(mapId) && isValidId(nodeId)
            && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        }

        match /edges/{edgeId} {
          allow get: if isValidId(userId) && isValidId(mapId) && isValidId(edgeId)
            && isOwner(userId) && existing().ownerId == request.auth.uid;
          allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(mapId) && isValidId(edgeId)
            && isVerifiedOwner(userId)
            && isValidMapEdge(incoming(), userId, mapId, edgeId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && ownsParentMap(userId, mapId);
          allow update: if isValidId(userId) && isValidId(mapId) && isValidId(edgeId)
            && isVerifiedOwner(userId)
            && isValidMapEdge(incoming(), userId, mapId, edgeId)
            && incoming().id == existing().id
            && incoming().ownerId == existing().ownerId
            && incoming().mapId == existing().mapId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'updatedAt']);
          allow delete: if isValidId(userId) && isValidId(mapId) && isValidId(edgeId)
            && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        }

        match /dumps/{dumpId} {
          allow get: if isValidId(userId) && isValidId(mapId) && isValidId(dumpId)
            && isOwner(userId) && existing().ownerId == request.auth.uid;
          allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(mapId) && isValidId(dumpId)
            && isVerifiedOwner(userId)
            && isValidBrainDump(incoming(), userId, mapId, dumpId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && ownsParentMap(userId, mapId);
          allow update: if isValidId(userId) && isValidId(mapId) && isValidId(dumpId)
            && isVerifiedOwner(userId)
            && isValidBrainDump(incoming(), userId, mapId, dumpId)
            && incoming().id == existing().id
            && incoming().ownerId == existing().ownerId
            && incoming().mapId == existing().mapId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['mapped', 'updatedAt'])
              || incoming().diff(existing()).affectedKeys().hasOnly(['rawText', 'moodWord', 'mapped', 'updatedAt'])
            );
          allow delete: if isValidId(userId) && isValidId(mapId) && isValidId(dumpId)
            && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        }

        match /patterns/{patternId} {
          allow get: if isValidId(userId) && isValidId(mapId) && isValidId(patternId)
            && isOwner(userId) && existing().ownerId == request.auth.uid;
          allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(mapId) && isValidId(patternId)
            && isVerifiedOwner(userId)
            && isValidPatternInsight(incoming(), userId, mapId, patternId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && ownsParentMap(userId, mapId);
          allow update: if isValidId(userId) && isValidId(mapId) && isValidId(patternId)
            && isVerifiedOwner(userId)
            && isValidPatternInsight(incoming(), userId, mapId, patternId)
            && incoming().id == existing().id
            && incoming().ownerId == existing().ownerId
            && incoming().mapId == existing().mapId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'insight', 'tone', 'relatedNodeIds', 'updatedAt']);
          allow delete: if isValidId(userId) && isValidId(mapId) && isValidId(patternId)
            && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        }
      }
    }
  }
}
